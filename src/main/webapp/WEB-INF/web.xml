<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Domino MCP Servlet</display-name>

    <description>
        MCP-Gateway-Servlet fuer HCL Domino (v2.0), Komponente des
        Domino MCP Toolkit. Reines HTTP-Gateway zwischen LLM (MCP/JSON-RPC)
        und Notes-Datenbank: Tool-Liste und Tool-Implementierungen liefert
        der Web-Agent in der Notes-DB mcp_tools.nsf (Agent McpGateway,
        OpenNTF-Release "Domino MCP Toolkit", s. AGENT_CONTRACT.md).
        Konfigurationslos: Der Agent-Host wird aus dem Request abgeleitet.
    </description>

    <!-- Servlet Definition -->
    <servlet>
        <servlet-name>DominoMcpServlet</servlet-name>
        <!-- Default-Package: die Domino-web.xml registriert die Servlet
             mit dem einfachen Namen DominoMcpServlet (kein Package). -->
        <servlet-class>DominoMcpServlet</servlet-class>
        <load-on-startup>1</load-on-startup>
        <!-- Kein Init-Param: Die Servlet ist konfigurationslos (Agent
             mcp_tools.nsf/McpGateway auf dem eigenen Server). -->
    </servlet>

    <!-- Servlet Mapping -->
    <servlet-mapping>
        <servlet-name>DominoMcpServlet</servlet-name>
        <url-pattern>/mcp/servlet</url-pattern>
    </servlet-mapping>

    <!-- Security Constraints (optional - für Produktion anpassen) -->
    <security-constraint>
        <web-resource-collection>
            <web-resource-name>MCP Endpoint</web-resource-name>
            <url-pattern>/mcp/servlet</url-pattern>
            <http-method>POST</http-method>
        </web-resource-collection>
        <auth-constraint>
            <role-name>domino-user</role-name>
        </auth-constraint>
    </security-constraint>

    <!-- Security Roles -->
    <security-role>
        <role-name>domino-user</role-name>
    </security-role>

    <!-- Konfiguration: keine — die Servlet arbeitet ohne externe Einstellungen. -->

    <!-- Error Handler (optional) -->
    <error-page>
        <error-code>500</error-code>
        <location>/error/500</location>
    </error-page>

    <error-page>
        <error-code>404</error-code>
        <location>/error/404</location>
    </error-page>

    <!-- Welcome File (optional) -->
    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

</web-app>
